rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Get user companyId from token (may be null if custom claims not set)
    function getUserCompanyId() {
      return request.auth.token.companyId;
    }
    
    // Check if user is platform admin from token (may be false if custom claims not set)
    function isPlatformAdmin() {
      return request.auth.token.isPlatformAdmin == true;
    }

    function hasPlatformAdminFlag() {
      return isAuthenticated() && (
        isPlatformAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPlatformAdmin == true)
      );
    }
    
    function isCompanyOwner() {
      return request.auth.token.isCompanyOwner == true;
    }

    function hasCompanyClaim() {
      // Check if companyId exists and is not empty
      return request.auth.token.companyId != null && 
             request.auth.token.companyId != '';
    }

    function matchesCompany(resource) {
      // If custom claims are set, use them. Otherwise, allow if authenticated (app-level filtering)
      return hasCompanyClaim() && resource.data.companyId != null && resource.data.companyId == getUserCompanyId();
    }
    
    function canManageSubscription() {
      return request.auth.token.canManageSubscription == true;
    }
    
    function isSameCompany(resource) {
      return hasCompanyClaim() && resource.data.companyId == getUserCompanyId();
    }
    
    function isSameCompanyOrPlatformAdmin(resource) {
      return isSameCompany(resource) || isPlatformAdmin();
    }
    
    // Helper: Allow read if authenticated (company filtering done in app)
    function canReadIfAuthenticated() {
      return isAuthenticated();
    }

    // Users collection - company isolation
    match /users/{userId} {
      // Allow reads for authenticated users
      // Platform admins and users without company claims can read all
      // Otherwise, allow if user is themselves or belongs to same company
      allow read: if isAuthenticated() && (
        isPlatformAdmin() ||
        !hasCompanyClaim() || // If no custom claims, allow all (app validates)
        userId == request.auth.uid ||
        (resource != null && matchesCompany(resource)) ||
        true // Temporary: allow all authenticated users (app-level filtering)
      );

      allow create: if isAuthenticated() && (
        isPlatformAdmin() ||
        !hasCompanyClaim() || // If no custom claims, allow (app validates)
        userId == request.auth.uid ||
        (request.resource.data.companyId != null && hasCompanyClaim() && request.resource.data.companyId == getUserCompanyId())
      );

      allow update: if isAuthenticated() && (
        hasPlatformAdminFlag() ||
        !hasCompanyClaim() || // If no custom claims, allow (app validates)
        userId == request.auth.uid ||
        (resource != null && matchesCompany(resource))
      );
      allow delete: if isAuthenticated() && (
        isPlatformAdmin() ||
        userId == request.auth.uid
      );
    }

    // Companies collection
    match /companies/{companyId} {
      // Allow reads for authenticated users
      // Platform admins, owners, and users with matching companyId can read
      // Also allow if no custom claims (app-level filtering will handle companyId matching)
      // This is necessary because custom claims may not be set or synced for all users
      allow read: if isAuthenticated() && (
        isPlatformAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        (hasCompanyClaim() && getUserCompanyId() == companyId) ||
        !hasCompanyClaim() || // If no custom claims, allow (app validates companyId)
        true // Temporary: allow all authenticated users (app-level filtering)
      );
      
      // Allow create if user is setting themselves as owner (for signup)
      allow create: if isAuthenticated() && 
        request.resource.data.ownerId == request.auth.uid;
      
      // Allow update only for owners or platform admins
      allow update: if isAuthenticated() && 
        (resource.data.ownerId == request.auth.uid || isPlatformAdmin());
      
      // Allow delete only for owners or platform admins
      allow delete: if isAuthenticated() && 
        (resource.data.ownerId == request.auth.uid || isPlatformAdmin());
    }
    
    // Company settings subcollection
    match /companies/{companyId}/settings/{settingId} {
      allow read, write: if isAuthenticated() && 
        (getUserCompanyId() == companyId || isPlatformAdmin());
    }

    // Receipts collection - company isolation
    match /receipts/{receiptId} {
      // Allow reads for authenticated users (company filtering done in application code)
      // This is necessary because custom claims may not be set
      allow read: if isAuthenticated();
      
      // For writes, check companyId if custom claims are available, otherwise allow if authenticated
      // Application code should validate companyId before writing
      allow write: if isAuthenticated() && (
        isPlatformAdmin() ||
        !hasCompanyClaim() || // If no custom claims, allow (app validates)
        resource.data.companyId == getUserCompanyId() ||
        (resource.data.companyId == null || resource.data.companyId == '') // Allow empty/null for legacy users or when user doc hasn't synced with claims
      );
      
      allow create: if isAuthenticated() && (
        isPlatformAdmin() ||
        !hasCompanyClaim() || // If no custom claims, allow any companyId (app validates)
        request.resource.data.companyId == getUserCompanyId() || // If has claim, must match
        (request.resource.data.companyId == null || request.resource.data.companyId == '') // Allow empty/null for legacy users or when user doc hasn't synced with claims
      );
    }

    // Subscription usage tracking
    match /subscriptionUsage/{usageId} {
      allow read: if isAuthenticated();
      // Allow create for authenticated users (during signup, users don't have companyId in claims yet)
      // App-level validation ensures companyId is set correctly
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        !hasCompanyClaim() ||
        resource.data.companyId == getUserCompanyId() || 
        isPlatformAdmin()
      );
      allow delete: if isAuthenticated() && (
        !hasCompanyClaim() ||
        resource.data.companyId == getUserCompanyId() || 
        isPlatformAdmin()
      );
    }

    // Invitations collection - company isolation
    match /invitations/{invitationId} {
      // Allow reads/writes for authenticated users
      // Platform admins and users without company claims can read all
      // Otherwise, allow if user is the inviter
      allow read, write: if isAuthenticated() && (
        isPlatformAdmin() ||
        !hasCompanyClaim() || // If no custom claims, allow all (app validates)
        resource.data.invitedBy == request.auth.token.email ||
        true // Temporary: allow all authenticated users (app-level filtering)
      );
      allow create: if isAuthenticated() && (
        isPlatformAdmin() ||
        !hasCompanyClaim() || // If no custom claims, allow (app validates)
        request.resource.data.invitedBy == request.auth.token.email
      );
    }

    // OCR analysis results - company isolation
    match /ocrAnalysis/{analysisId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        !hasCompanyClaim() ||
        resource.data.companyId == getUserCompanyId() || 
        isPlatformAdmin()
      );
      allow create: if isAuthenticated() && (
        !hasCompanyClaim() ||
        request.resource.data.companyId == getUserCompanyId() || 
        isPlatformAdmin()
      );
    }

    // Fraud analysis results - company isolation
    match /fraudAnalysis/{analysisId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        !hasCompanyClaim() ||
        resource.data.companyId == getUserCompanyId() || 
        isPlatformAdmin()
      );
      allow create: if isAuthenticated() && (
        !hasCompanyClaim() ||
        request.resource.data.companyId == getUserCompanyId() || 
        isPlatformAdmin()
      );
    }

    // Receipt submissions - company isolation
    match /receiptSubmissions/{submissionId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        !hasCompanyClaim() ||
        resource.data.companyId == getUserCompanyId() || 
        isPlatformAdmin()
      );
      allow create: if isAuthenticated() && (
        !hasCompanyClaim() ||
        request.resource.data.companyId == getUserCompanyId() || 
        isPlatformAdmin()
      );
    }

    // Monitoring and analytics collections - allow authenticated users to write
    match /analytics_events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    match /performance_metrics/{metricId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    match /error_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    match /system_health/{healthId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() && (
        isPlatformAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.userId == request.auth.token.email ||
        (!hasCompanyClaim() || (hasCompanyClaim() && resource.data.companyId == getUserCompanyId()))
      );
      
      // Users can create notifications for themselves
      allow create: if isAuthenticated() && (
        isPlatformAdmin() ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.token.email ||
        (!hasCompanyClaim() || (hasCompanyClaim() && request.resource.data.companyId == getUserCompanyId()))
      );
      
      // Users can update their own notifications (e.g., mark as read)
      allow update: if isAuthenticated() && (
        isPlatformAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.userId == request.auth.token.email ||
        (!hasCompanyClaim() || (hasCompanyClaim() && resource.data.companyId == getUserCompanyId()))
      );
      
      // Users can delete their own notifications
      allow delete: if isAuthenticated() && (
        isPlatformAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.userId == request.auth.token.email ||
        (!hasCompanyClaim() || (hasCompanyClaim() && resource.data.companyId == getUserCompanyId()))
      );
    }
  }
}